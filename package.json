{
  "name": "tencent-docs-publisher",
  "version": "0.1.1",
  "description": "Obsidian plugin to publish notes and document trees to Tencent Docs",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tencent-docs",
    "markdown",
    "publish"
  ],
  "author": "totok22",
  "license": "MIT",
  "dependencies": {
    "spark-md5": "3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.20.2",
    "@types/spark-md5": "3.0.5",
    "esbuild": "0.25.5",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.6.0",
    "jiti": "2.6.1",
    "obsidian": "1.13.1",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1",
    "vitest": "2.1.9"
  }
}
